%%bigquery
SELECT CustomerName, STRING_AGG(DISTINCT ProductName, ', ' ORDER BY ProductName) AS Products
FROM
(
  SELECT A.CustomerID, A.CustomerName, B.ProductID, C.Name AS ProductName
  FROM
  (
    SELECT * FROM `ba-777.public.customer_info`
    UNION DISTINCT
    SELECT CustomerID, * EXCEPT(CustomerID) FROM `ba-777.public.customer_info_past`
  ) A
  LEFT JOIN `ba-777.public.transactions` B
  ON A.CustomerID = B.CustomerID
  LEFT JOIN `ba-777.public.product_info` C
  ON B.ProductID = C.ID
)
GROUP BY CustomerID, CustomerName
ORDER BY CustomerName

-- STRING_AGG skips NULLs. Alberto bought nothing, so his list is NULL.
-- John's product 777 has no name, so only Water shows up for him.
