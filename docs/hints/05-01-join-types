%%bigquery
SELECT
  (SELECT COUNT(*) FROM `ba-777.public.transactions` A INNER JOIN `ba-777.public.product_info` B ON A.ProductID = B.ID) AS inner_join,
  (SELECT COUNT(*) FROM `ba-777.public.transactions` A LEFT JOIN `ba-777.public.product_info` B ON A.ProductID = B.ID) AS left_join,
  (SELECT COUNT(*) FROM `ba-777.public.transactions` A RIGHT JOIN `ba-777.public.product_info` B ON A.ProductID = B.ID) AS right_join,
  (SELECT COUNT(*) FROM `ba-777.public.transactions` A FULL OUTER JOIN `ba-777.public.product_info` B ON A.ProductID = B.ID) AS full_outer_join

